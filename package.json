{
  "name": "signalk-czone",
  "version": "0.3.0-beta.8",
  "description": "Standalone Signal K CZone NMEA2000 current decoder with validated ZCF upload configuration and AC/DC classification metadata",
  "main": "index.js",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin",
    "signalk-plugin-configurator",
    "signalk-category-digital-switching",
    "czone",
    "nmea2000"
  ],
  "license": "MIT",
  "signalk": {
    "displayName": "CZone",
    "appIcon": "./img/czone-circuits.png",
    "recommends": [
      "@signalk/signalk-to-influxdb2"
    ],
    "screenshots": [
      "./img/config.png",
      "./img/diagnostics.png",
      "./img/grafana-example.png"
    ]
  },
  "author": "svSugarShack <matt@ick.com>",
  "signalk-plugin-enabled-by-default": true,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "lib/",
    "public/",
    "img/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/zcf.test.js && node test/zcf-fixtures.test.js"
  },
  "dependencies": {
    "signalk-czone-zcf": "github:mattsmitchell/signalk-czone-zcf#main"
  }
}
